# Copier ce fichier en .env puis adapter les valeurs.
DEBUG=True
SECRET_KEY=changez-moi-avec-une-longue-cle-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# SQLite en développement (par défaut). En production, PostgreSQL :
# DATABASE_URL=postgres://pelerins:motdepasse@localhost:5432/pelerins
# DATABASE_URL=sqlite:///db.sqlite3

# Taille maximale d'un document joint (Mo)
DOCUMENTS_TAILLE_MAX_MO=5

# Durée de session (secondes)
SESSION_COOKIE_AGE=28800

# Mot de passe du compte « demo » (commande donnees_demo --admin, développement uniquement)
DEMO_PASSWORD=
